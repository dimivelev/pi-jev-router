    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm test"
  }
