{
  "name": "@dimivelev/pi-jev-router",
  "version": "0.1.0",
  "description": "A Pi extension that routes tasks between chat models using Jev difficulty classification.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimivelev/pi-jev-router.git"
  },
  "homepage": "https://github.com/dimivelev/pi-jev-router#readme",
  "bugs": {
    "url": "https://github.com/dimivelev/pi-jev-router/issues"
  },
  "keywords": ["pi-package", "pi-extension", "jev", "model-routing"],
  "files": ["index.ts", "policy.ts", "router-settings.ts", "router-secrets.ts", "README.md", ".env.example"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "engines": {
    "node": ">=22.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
